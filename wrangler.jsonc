{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yalo-wallet",
  "compatibility_date": "2026-11-19",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/worker/index.ts",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
