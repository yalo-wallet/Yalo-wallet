
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yalo-wallet",
  "compatibility_date": "2026-11-17",
  "pages_build_output_dir": "./dist",
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issues": {
      "enabled": true
    }
  }
}
